{
  "agentCanUpdateSnapshot": false,
  "install": "cmake -S . -B build-vs2022 -G \"Visual Studio 17 2022\" -A x64",
  "terminals": [
    {
      "name": "Build Debug",
      "command": "cmake --build build-vs2022 --config Debug"
    },
    {
      "name": "Run Debug (no DXR)",
      "command": "pwsh -NoLogo -NoProfile -Command \"$env:PLASMADX_DISABLE_DXR='1'; $env:PLASMADX_USE_CURL='1'; $env:PLASMADX_NO_QUIT_ON_REMOVAL='1'; Start-Process -FilePath 'build-vs2022\\Debug\\PlasmaDX.exe' -WorkingDirectory (Get-Location).Path\""
    },
    {
      "name": "Run Debug (DXR on)",
      "command": "pwsh -NoLogo -NoProfile -Command \"$env:PLASMADX_DISABLE_DXR='0'; $env:PLASMADX_NO_QUIT_ON_REMOVAL='1'; Start-Process -FilePath 'build-vs2022\\Debug\\PlasmaDX.exe' -WorkingDirectory (Get-Location).Path\""
    }
  ]
}