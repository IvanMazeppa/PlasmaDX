#!/usr/bin/env bash
set -euo pipefail

# Block commits that delete protected project paths
protected_paths=(
  "CMakeLists.txt"
  "CMakePresets.json"
  "src/"
  "shaders/"
  "changes/"
  "results/"
  "pix/"
  "tools/"
  "third_party/"
  "DX12_MCP_README.md"
)

# List deleted or renamed-away files in the index
deleted_files=$(git diff --cached --name-status --diff-filter=DR | awk '{print $2}')

blocked=()
for f in ${deleted_files}; do
  for p in "${protected_paths[@]}"; do
    case "$f" in
      "$p"|$p*) blocked+=("$f"); break;;
    esac
  done
done

if [ ${#blocked[@]} -gt 0 ]; then
  echo "Pre-commit blocked: attempted deletion/rename of protected paths:" >&2
  for b in "${blocked[@]}"; do echo "  - $b" >&2; done
  echo "If this is intentional, adjust .githooks/pre-commit protected_paths." >&2
  exit 1
fi

exit 0


